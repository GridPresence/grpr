#!/usr/bin/env python3

import os
from pathlib import Path


def walk(spath: Path):
    """Some stuff"""
    for path in sorted(spath.iterdir(), reverse=False):
        if path.is_dir():
            # print(path)
            yield from walk(path)
            continue
        yield path.resolve()


def scan(source: Path):
    """Run here"""
    for fyle in walk(spath=source):
        if fyle.suffix in [".mp3", ".flac", ".m3u"]:
            print(fyle)


if __name__ == "__main__":
    print("-------- Entering gppy_py")
    sources = Path(os.getenv("FLACSRCS"))
    print(sources)
    playlists = Path(os.getenv("PLAYLISTS"))
    print(playlists)
    scan(source=sources)
    print("--------  Exiting gppy_py")
